{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-energy-tool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Next.js static export. The Worker runs first so it can gate pages behind the password + magic link.
  "assets": { "directory": "out", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "durable_objects": { "bindings": [{ "name": "TreeRoom", "class_name": "TreeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "ai-energy-tool", "database_id": "aada9a3e-f90e-480c-8b3c-3fbcb722e5ed", "migrations_dir": "migrations" }],
  // Cloudflare Email Sending (outbound). The from-domain must already be onboarded to Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://ai-energy-tool.mannanteam.workers.dev",
    "APP_NAME": "AI Energy Tool",
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "AI Energy Tool <no-reply@skeleton.mannan.is>",
    "DEV_ORIGIN": ""
  }
  // Secrets (wrangler secret put): WORKSPACE_PASSWORD, SESSION_SECRET
}
