# OpenRouter key (small-limit test key, intentionally committed to local disk only; .env* is gitignored)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# model used to play the resident in scripts/simulate.ts
SIM_MODEL=deepseek/deepseek-v4-flash
PORT=8972
# where share links point; change if you expose the server
PUBLIC_ORIGIN=http://localhost:8972
DB_PATH=./data/chats.sqlite
TYPESAFE_API_KEY=apikey_...
TYPESAFE_MODEL=jev-latest
